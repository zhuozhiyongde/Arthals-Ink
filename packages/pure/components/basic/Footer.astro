---
import config from 'virtual:config'

import { Icon } from '../user'

const currentYear = new Date().getFullYear()
const startYear = config.since
const displayYear =
  startYear && startYear < currentYear ? `${startYear} - ${currentYear}` : currentYear

const footerConf = config.footer
const social = footerConf.social || []

const footerLink = footerConf.links || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-md:flex-col md:justify-between md:gap-y-0'>
      <div
        class='flex items-center gap-x-4 gap-y-2 text-sm text-muted-foreground max-md:flex-col [&_a]:text-foreground'
      >
        <div>
          © {displayYear}
          {config.author}
        </div>
        {
          footerConf.credits && (
            <div>
              <a href='https://github.com/withastro/astro' target='_blank'>
                Astro
              </a>
              &
              <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>
                Pure
              </a>
              theme powered
            </div>
          )
        }
        {
          footerLink.length > 0 && (
            <div class='flex items-center gap-x-2 justify-center'>
              {footerLink.map(({ title, link, style }, index) => (
                <>
                  <a href={link} target='_blank' class={style}>
                    {title}
                  </a>
                  <span>{index < footerLink.length - 1 && '|'}</span>
                </>
              ))}
            </div>
          )
        }
      </div>

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex'>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>
